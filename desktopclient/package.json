{
  "name": "@bosdb/desktopclient",
  "version": "0.1.0",
  "description": "Native BosDB Desktop Client",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "start": "electron . --no-sandbox",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --no-sandbox\""
  },
  "dependencies": {
    "@bosdb/core": "*",
    "@bosdb/db-adapters": "*",
    "@bosdb/security": "*",
    "@bosdb/utils": "*",
    "@monaco-editor/react": "^4.7.0",
    "dotenv": "^9.0.2",
    "electron-is-dev": "^2.0.0",
    "lucide-react": "^0.294.0",
    "mongodb": "^7.0.0",
    "mysql2": "^3.16.1",
    "pg": "^8.17.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.bosdb.native",
    "productName": "BosDB",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "dist-renderer/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}