{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "incremental": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "@bosdb/core": [
                "./packages/core/src"
            ],
            "@bosdb/utils": [
                "./packages/utils/src"
            ],
            "@bosdb/debugger-core": [
                "./packages/debugger-core/src"
            ],
            "@bosdb/debugger-protocol": [
                "./packages/debugger-protocol/src"
            ],
            "@bosdb/db-adapters": [
                "./packages/db-adapters/src"
            ]
        }
    },
    "exclude": [
        "node_modules",
        "dist",
        ".next"
    ]
}