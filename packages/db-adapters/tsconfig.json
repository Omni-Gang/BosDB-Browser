{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "composite": true,
        "types": [
            "node"
        ],
        "paths": {
            "@bosdb/core": [
                "../core/src"
            ],
            "@bosdb/utils": [
                "../utils/src"
            ],
            "@bosdb/debugger-core": [
                "../debugger-core/src"
            ]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts"
    ],
    "references": [
        {
            "path": "../core"
        },
        {
            "path": "../utils"
        },
        {
            "path": "../debugger-core"
        }
    ]
}